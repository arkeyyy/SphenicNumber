<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="app-root" stylesheets="@sphenic.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.sphenic_number.SphenicController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <VBox spacing="5.0">
        <Label text="Sphenic Number Explorer" styleClass="app-title"/>
        <Label text="Find numbers that are the product of exactly three distinct primes. For example, 30 = 2 × 3 × 5."
               styleClass="subtitle" wrapText="true"/>
    </VBox>

    <VBox spacing="8.0" styleClass="input-panel">
        <GridPane hgap="12.0" vgap="6.0">
            <columnConstraints>
                <ColumnConstraints minWidth="120.0" prefWidth="280.0" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="135.0" prefWidth="210.0" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="84.0" prefWidth="84.0"/>
                <ColumnConstraints minWidth="84.0" prefWidth="84.0"/>
            </columnConstraints>
            <TextField fx:id="numField" text="100" promptText="e.g. 1000000"
                       accessibleText="Upper limit" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="cntField" text="3" promptText="e.g. 3"
                       accessibleText="Number of threads" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Upper limit" labelFor="$numField" styleClass="field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Number of threads" labelFor="$cntField" styleClass="field-label"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button fx:id="startButton" text="Start" onAction="#onStart" defaultButton="true"
                    maxWidth="Infinity" styleClass="primary-button"
                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" cancelButton="true"
                    maxWidth="Infinity" disable="true"
                    GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        </GridPane>
        <Label text="Whole numbers only · Upper limit: 1–10,000,000 · Threads: 1–64, no more than the upper limit"
               styleClass="helper-text" wrapText="true"/>
        <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true"
               styleClass="error-message"/>
    </VBox>

    <SplitPane dividerPositions="0.53" styleClass="workspace" minHeight="160.0" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="10.0" minWidth="270.0" minHeight="0.0" styleClass="workspace-panel">
                <Label text="Thread progress" styleClass="section-title"/>
                <Label text="Each thread checks its own range. Unequal workloads make progress easier to compare."
                       wrapText="true" minHeight="-Infinity" styleClass="helper-text"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            minHeight="0.0" styleClass="worker-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="workerRows" spacing="10.0" fillWidth="true"/>
                    </content>
                </ScrollPane>
            </VBox>
            <VBox spacing="10.0" minWidth="270.0" minHeight="0.0" styleClass="workspace-panel">
                <Label fx:id="resultsTitleLabel" text="Sphenic numbers" styleClass="section-title"/>
                <HBox spacing="10.0">
                    <VBox spacing="3.0" styleClass="summary-tile" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Sphenic" styleClass="helper-text"/>
                        <Label fx:id="sphenicCountLabel" text="—" styleClass="summary-count"/>
                    </VBox>
                    <VBox spacing="3.0" styleClass="summary-tile" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Non-sphenic" styleClass="helper-text"/>
                        <Label fx:id="nonSphenicCountLabel" text="—" styleClass="summary-count"/>
                    </VBox>
                </HBox>
                <Label fx:id="resultsHintLabel" text="Run a search to see the results."
                       wrapText="true" minHeight="-Infinity" styleClass="helper-text"/>
                <ListView fx:id="matchesList" minHeight="0.0" prefHeight="240.0" fixedCellSize="30.0"
                          accessibleText="Sphenic numbers in ascending order" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Results will appear here." wrapText="true" styleClass="empty-message"/>
                    </placeholder>
                </ListView>
            </VBox>
        </items>
    </SplitPane>

    <Label fx:id="statusLabel" text="Ready to start." wrapText="true" styleClass="run-status"/>
</VBox>
